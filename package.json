{
  "name": "brandhub-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:staging": "APP_ENV=staging expo start --dev-client",
    "start:production": "APP_ENV=production expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot > .dependency-cruiser-graph.dot",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run boundaries && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "dependency-cruiser": "18.2.0",
    "dotenv": "^17.2.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "54.0.18",
    "lint-staged": "16.2.7",
    "prettier": "3.9.6",
    "react-test-renderer": "19.1.0",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  }
}
