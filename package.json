{
  "name": "brandhub-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:staging": "APP_ENV=staging expo start --go",
    "start:production": "APP_ENV=production expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "mock": "tsx mock-server/server.ts",
    "mock:reset": "tsx mock-server/seed/generate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,md}\"",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "boundaries:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot > .dependency-cruiser-graph.dot",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:contract": "jest contract-tests --runInBand",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run boundaries && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/noto-kufi-arabic": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "^57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "i18next": "^26.4.1",
    "react": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react-native": "^14.0.1",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@types/supertest": "^6.0.3",
    "babel-jest": "^29.7.0",
    "dependency-cruiser": "18.2.0",
    "dotenv": "^17.2.1",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import": "2.32.0",
    "express": "^4.21.2",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "json-server": "^0.17.4",
    "lint-staged": "16.2.7",
    "msw": "^1.3.5",
    "prettier": "3.9.6",
    "react-test-renderer": "^19.2.3",
    "supertest": "^7.1.4",
    "test-renderer": "^1.2.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3"
  }
}
