# Copy to .env.development / .env.staging / .env.production and fill in.
# NOTHING SECRET BELONGS HERE. Every value below is embedded in the shipped
# bundle and is readable by anyone with the app. See architecture.md §28 S4.

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1
EXPO_PUBLIC_DEFAULT_LOCALE=ar
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000
EXPO_PUBLIC_ENABLE_DEV_MENU=true
